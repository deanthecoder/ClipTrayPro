<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClipTrayPro.ImageCompareWindow"
        Title="Compare Images"
        Width="980"
        Height="760"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        RequestedThemeVariant="Dark">
  <Window.Styles>
    <FluentTheme />
  </Window.Styles>

  <Grid Margin="18"
        RowDefinitions="Auto,*,Auto,Auto,Auto"
        RowSpacing="12">
    <Grid Grid.Row="0">
      <StackPanel Spacing="3">
        <TextBlock Text="Image comparison" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="Fade between the previous and latest clipboard images." Opacity="0.72" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1"
            Background="#FFFFFFFF"
            BorderBrush="#4FFFFFFF"
            BorderThickness="1"
            CornerRadius="4"
            ClipToBounds="True">
      <Grid>
        <Image x:Name="PreviousImage" Stretch="Uniform" />
        <Image x:Name="DifferenceImage" Stretch="Uniform" IsVisible="False" />
        <Image x:Name="LatestImage" Stretch="Uniform" Opacity="0" />
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="14">
      <CheckBox x:Name="DifferenceMaskBox"
                Content="Difference mask"
                IsChecked="True"
                VerticalAlignment="Center"
                IsCheckedChanged="OnDifferenceMaskChanged" />
      <Slider Grid.Column="1"
              x:Name="BlendSlider"
              Minimum="0"
              Maximum="100"
              Value="50"
              TickFrequency="50"
              ValueChanged="OnBlendValueChanged" />
    </Grid>

    <Grid Grid.Row="3" ColumnDefinitions="*,*,*">
      <TextBlock Text="Previous" HorizontalAlignment="Left" Opacity="0.72" />
      <TextBlock x:Name="DifferenceLabel"
                 Grid.Column="1"
                 Text="Difference"
                 HorizontalAlignment="Center"
                 Opacity="0.72" />
      <TextBlock Grid.Column="2" Text="Latest" HorizontalAlignment="Right" Opacity="0.72" />
    </Grid>

    <StackPanel Grid.Row="4" Spacing="3">
      <Grid ColumnDefinitions="*,*">
        <TextBlock x:Name="PreviousDetailsText"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Left" />
        <TextBlock x:Name="LatestDetailsText"
                   Grid.Column="1"
                   TextWrapping="Wrap"
                   TextAlignment="Right"
                   HorizontalAlignment="Right" />
      </Grid>
      <TextBlock x:Name="DifferenceDetailsText"
                 TextWrapping="Wrap"
                 FontSize="12"
                 Opacity="0.68" />
    </StackPanel>
  </Grid>
</Window>
